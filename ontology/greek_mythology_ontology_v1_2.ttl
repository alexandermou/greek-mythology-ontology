@prefix gmo: <https://example.org/greek-mythology-ontology/> .
@prefix ent: <https://example.org/greek-mythology-ontology/entity/> .
@prefix prop: <https://example.org/greek-mythology-ontology/property/> .
@prefix claim: <https://example.org/greek-mythology-ontology/claim/> .
@prefix src: <https://example.org/greek-mythology-ontology/source/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gmo:Ontology a owl:Ontology ;
  rdfs:label "Greek Mythology Ontology v1.2"@en ;
  rdfs:label "希腊神话人物关系本体论 v1.2"@zh .

gmo:MythologicalEntity a owl:Class ; rdfs:label "神话实体"@zh .
gmo:Character a owl:Class ; rdfs:label "人物"@zh .
gmo:Deity a owl:Class ; rdfs:label "神祇"@zh .
gmo:PrimordialDeity a owl:Class ; rdfs:label "原初神"@zh .
gmo:Titan a owl:Class ; rdfs:label "泰坦"@zh .
gmo:Olympian a owl:Class ; rdfs:label "奥林匹斯神"@zh .
gmo:Demigod a owl:Class ; rdfs:label "半神"@zh .
gmo:Mortal a owl:Class ; rdfs:label "凡人"@zh .
gmo:Hero a owl:Class ; rdfs:label "英雄"@zh .
gmo:Creature a owl:Class ; rdfs:label "神话生物"@zh .
gmo:Place a owl:Class ; rdfs:label "地点"@zh .
gmo:Event a owl:Class ; rdfs:label "事件"@zh .
gmo:Group a owl:Class ; rdfs:label "群体"@zh .
gmo:Source a owl:Class ; rdfs:label "来源"@zh .
gmo:Claim a owl:Class ; rdfs:label "主张/断言"@zh .

prop:fatherOf a owl:ObjectProperty ; rdfs:label "父亲"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:motherOf a owl:ObjectProperty ; rdfs:label "母亲"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:parentOf a owl:ObjectProperty ; rdfs:label "亲代"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:spouseOf a owl:ObjectProperty ; rdfs:label "配偶"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:consortOf a owl:ObjectProperty ; rdfs:label "伴侣"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:siblingOf a owl:ObjectProperty ; rdfs:label "兄弟姐妹"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:emergedFrom a owl:ObjectProperty ; rdfs:label "特殊出生/产生于"@zh ; rdfs:domain gmo:MythologicalEntity ; rdfs:range gmo:MythologicalEntity .
prop:kills a owl:ObjectProperty ; rdfs:label "杀死"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:defeats a owl:ObjectProperty ; rdfs:label "击败"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:MythologicalEntity .
prop:helps a owl:ObjectProperty ; rdfs:label "帮助"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:commands a owl:ObjectProperty ; rdfs:label "命令"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:conflictsWith a owl:ObjectProperty ; rdfs:label "冲突"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .
prop:associatedWith a owl:ObjectProperty ; rdfs:label "关联"@zh ; rdfs:domain gmo:MythologicalEntity ; rdfs:range gmo:MythologicalEntity .
prop:memberOf a owl:ObjectProperty ; rdfs:label "成员"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Group .
prop:engagedTo a owl:ObjectProperty ; rdfs:label "订婚"@zh ; rdfs:domain gmo:Character ; rdfs:range gmo:Character .

